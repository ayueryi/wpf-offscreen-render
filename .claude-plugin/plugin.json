{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "wpf-offscreen-render",
  "displayName": "WPF Offscreen Render",
  "version": "1.1.2",
  "description": "离屏渲染真实 WPF / XAML 界面为 PNG，返回截图、绑定错误与布局问题，支持前后对比与多主题 / 尺寸 / DPI 组合（需要 Windows）。",
  "author": { "name": "ayueryi", "url": "https://github.com/ayueryi" },
  "homepage": "https://github.com/ayueryi/wpf-offscreen-render",
  "repository": "https://github.com/ayueryi/wpf-offscreen-render",
  "keywords": ["wpf", "xaml", "screenshot", "visual-regression", "rendertargetbitmap", "dotnet", "windows"],
  "mcpServers": {
    "wpf-offscreen-render": {
      "command": "pwsh",
      "args": ["-NoProfile", "-NonInteractive", "-ExecutionPolicy", "Bypass", "-File", "${CLAUDE_PLUGIN_ROOT}/mcp/start.ps1"]
    }
  }
}
