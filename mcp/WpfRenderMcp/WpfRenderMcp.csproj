<Project Sdk="Microsoft.NET.Sdk">
  <!-- MCP 服务器：把 scripts/ 下的渲染、对比、自检能力暴露为 MCP 工具，供 Codex、Claude Code 等代理直接调用。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>WpfRenderMcp</AssemblyName>
    <RootNamespace>WpfRenderMcp</RootNamespace>
    <Version>1.3.1</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- 只装了 .NET 9 / 10 的机器上也能运行（默认只允许同主版本内的补丁 / 次版本前滚）。 -->
    <RollForward>Major</RollForward>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
  </ItemGroup>
</Project>
